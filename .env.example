# Copy to .env and fill in. .env is gitignored, and secrets live here and nowhere else.
# How the tool *runs* — provider, model ids, window, channels — is config/settings.yaml, not this file.

# --- Your LLM provider (scoring). One of these, matching llm.provider in config/settings.yaml. ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ollama needs no key — set llm.base_url instead.

# --- Optional: market-data sources (research/sources/). ---
# All three are OPTIONAL. Unset, the source logs one line and returns nothing; the six keyless agency
# scrapers still run. Nothing here gates the tool — the zero-key path is the default.

# Adzuna (free) — https://developer.adzuna.com
# Note: its salary figures are model *predictions*, not posted pay, and are labelled as such.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Free tier ~200 requests/month, which one query per search term spends quickly.
RAPIDAPI_KEY=

# TheirStack — https://theirstack.com. PAID: one credit per job *returned*, not per match.
THEIRSTACK_KEY=
